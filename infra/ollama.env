# Ollama service environment inside CT106 "openjarvis".
# Drop-in: /etc/systemd/system/ollama.service.d/override.conf
#   [Service]
#   Environment="OLLAMA_HOST=0.0.0.0:11434"
#   Environment="OLLAMA_ORIGINS=*"
# then: systemctl daemon-reload && systemctl restart ollama

# Listen on all interfaces so the host's DNAT rule can forward traffic in.
OLLAMA_HOST=0.0.0.0:11434

# Allow the file:// J.A.R.V.I.S. HUD to call the REST API cross-origin.
OLLAMA_ORIGINS=*
